<?xml version="1.0" encoding="UTF-8"?>
<!-- The host serving flytunl.ch is IIS (confirmed via response headers), which has
     no default MIME mapping for an extensionless file and 404s apple-app-site-association
     without this. <remove> before each <mimeMap> is defensive, not redundant: IIS
     throws a startup error on a duplicate mimeMap key, and some server configs
     already register .json globally - remove is a safe no-op either way, guaranteeing
     this never breaks the site regardless of what the server already has configured. -->
<configuration>
    <system.webServer>
        <staticContent>
            <remove fileExtension="." />
            <mimeMap fileExtension="." mimeType="application/json" />
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
        </staticContent>
    </system.webServer>
</configuration>
