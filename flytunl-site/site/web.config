<?xml version="1.0" encoding="UTF-8"?>
<!--
  flytunl.ch runs on IIS (behind Cloudflare). IIS serves only extensions it has a
  MIME mapping for and returns 404 for anything else - even when the file is on
  disk. Every page head links <link rel="manifest" href="/site.webmanifest">, and
  that URL 404'd from launch until 2026-09-13 for exactly this reason: the file was
  uploaded fine, IIS just would not serve the extension.

  Scope is deliberately one mapping. Nothing else here 404s - .svg, .txt, .m4a, .js
  and .png were all verified serving with correct content types - so this file stays
  minimal. A malformed or over-broad web.config 500s the entire site.

  The <remove> guard makes the mapping idempotent: if the host ever adds .webmanifest
  server-side, a duplicate key would otherwise be a 500 rather than a no-op.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
