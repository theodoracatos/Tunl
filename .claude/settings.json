{
  "permissions": {
    "allow": [
      "Bash(node --check *)",
      "Bash(open *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git push)",
      "Bash(plutil -lint *)",
      "Bash(dotnet list *)",
      "Bash(npm root *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git filter-branch*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-pointer.js\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
