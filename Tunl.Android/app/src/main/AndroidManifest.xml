<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Daily-reminder local notification (8.3). POST_NOTIFICATIONS is the
         Android 13+ runtime permission, requested when the player opts in.
         RECEIVE_BOOT_COMPLETED re-arms the AlarmManager alarm after a reboot.
         No exact-alarm permission: setAndAllowWhileIdle is inexact by design. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tunl">

        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- Consent mode defaults (Firebase Analytics, 8.3). Every signal starts
             denied. analytics_storage and ad_storage only accept true/false, so
             they deny globally and AdsManager grants them back once the UMP
             consent request resolves for a user where GDPR does not apply
             (consentStatus == NOT_REQUIRED). For EEA / UK / CH users the UMP SDK
             (4.0.0, needs 3.2.0 or newer) interprets the consent form choice and
             forwards it to Firebase Analytics itself, because Firebase is
             initialised by FirebaseInitProvider before AdsManager.start() runs
             the UMP SDK. ad_user_data / ad_personalization can be region scoped,
             so they deny for EEA only and need no runtime grant elsewhere. -->
        <meta-data
            android:name="google_analytics_default_allow_analytics_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="eu_consent_policy" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="eu_consent_policy" />

        <!-- Serves the shared run card (a PNG written to cacheDir/share) to whichever
             app the player picks in the share sheet. See MainActivity.shareRun and
             res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Tunl">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links (flytunl.ch/play/... - a friend's shared run, see
                 src/share.js shareRunUrl). autoVerify hands Android the domain
                 ownership check against /.well-known/assetlinks.json at install
                 time so a tap opens straight into the app instead of the browser,
                 no disambiguation sheet. Scoped to /play only, matching the AASA
                 file's iOS counterpart (GameView.swift/TunlApp.swift) - the
                 marketing pages under the bare domain have no in-app equivalent
                 to hand off to. singleTask above (not the default "standard")
                 is required for a warm/backgrounded app to receive this as
                 onNewIntent instead of spawning a duplicate instance. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="flytunl.ch"
                    android:pathPrefix="/play" />
            </intent-filter>
        </activity>

        <!-- Daily-reminder alarm target (ReminderScheduler / ReminderReceiver). Not
             exported: only this app's own AlarmManager fires it. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- Re-arms the reminder alarm after a device reboot. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
